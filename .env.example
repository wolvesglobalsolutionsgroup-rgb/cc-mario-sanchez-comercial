# ==============================================================================
# CENTRO COMERCIAL MARIO SÁNCHEZ C.A. — VARIABLES DE ENTORNO
# PILAR 4: GOBERNANZA DE RECURSOS, TECHOS DE GASTO & ALERTAS DE PRESUPUESTO
# ==============================================================================

# ENTORNO DE EJECUCIÓN (development | staging | production)
# Si es 'production', el Guardrail Anti-Destrucción impedirá comandos DROP TABLE o TRUNCATE.
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS RELACIONAL (SUPABASE / POSTGRESQL)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# TECHO DE GASTO SUPABASE:
# - Establecer "Spend Cap" = ENABLED en Project Settings -> Billing.
# - Activar alertas automáticas de facturación al 50%, 80% y 100% de la cuota mensual.

# ------------------------------------------------------------------------------
# 2. CORREO TRANSACCIONAL (RESEND API)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=cobranzas@ccmariosanchez.com

# TECHO DE GASTO RESEND:
# - Plan Free / Pro configurado con alerta de límite de envíos diarios.
# - Notificación al superar el 80% del límite de 3.000 correos/mes.

# ------------------------------------------------------------------------------
# 3. OBSERVABILIDAD & TELEMETRÍA (SENTRY / POSTHOG / AXIOM)
# ------------------------------------------------------------------------------
SENTRY_DSN=https://xxxxxxxx@o0000000.ingest.sentry.io/0000000
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ------------------------------------------------------------------------------
# 4. APIs DE TASAS FINANCIERAS & MERCADO (BCV & CRIPTO)
# ------------------------------------------------------------------------------
DOLARAPI_ENDPOINT=https://ve.dolarapi.com/v1/dolares/oficial
BINANCE_P2P_FALLBACK_RATE=947.30

# TIMEOUT GLOBAL PARA PETICIONES EXTERNAS (MILISEGUNDOS)
# Máximo estricto: 20000 (20 segundos)
EXTERNAL_API_TIMEOUT_MS=20000
MAX_TOKENS_LIMIT=2048
