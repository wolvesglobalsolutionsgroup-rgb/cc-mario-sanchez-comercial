{
  "name": "cc-mario-sanchez-comercial",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/landing", "destination": "/index.html" },
    { "source": "/landing.html", "destination": "/index.html" },
    { "source": "/alquiler", "destination": "/alquiler.html" },
    { "source": "/alquiler.html", "destination": "/alquiler.html" },
    { "source": "/gestion", "destination": "/gestion/index.html" },
    { "source": "/onboarding", "destination": "/gestion/onboarding.html" },
    { "source": "/login", "destination": "/gestion/login.html" },
    { "source": "/gestion/(.*)", "destination": "/gestion/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
