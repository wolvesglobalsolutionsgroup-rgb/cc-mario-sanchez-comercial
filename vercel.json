{
  "name": "cc-mario-sanchez-comercial",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/alquiler", "destination": "/alquiler.html" },
    { "source": "/alquiler.html", "destination": "/alquiler.html" },
    { "source": "/gestion", "destination": "/gestion/index.html" },
    { "source": "/gestion/", "destination": "/gestion/index.html" },
    { "source": "/onboarding", "destination": "/gestion/onboarding.html" },
    { "source": "/login", "destination": "/gestion/login.html" }
  ],
  "redirects": [
    { "source": "/login.html", "destination": "/login", "permanent": false },
    { "source": "/onboarding.html", "destination": "/onboarding", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
