          -64.6326151,10.2046851,4
          -64.6326685,10.2044512,4
          -64.6332309,10.2045362,4
          -64.6331808,10.2047841,4
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark><name>LOT-C03: 1.730 m² (Fte. 27,96 m)</name><styleUrl>#lblAmarilla</styleUrl><Point><coordinates>-64.63292,10.20461,4</coordinates></Point></Placemark>
