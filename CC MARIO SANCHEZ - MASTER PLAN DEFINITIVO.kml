  <!-- 3. PASILLOS Y ESTACIONAMIENTOS -->
  <Folder>
    <name>3. Pasillos y Operación Vial</name>
    <!-- Pasillo Oeste 20 m -->
    <Placemark>
      <name>Pasillo O: 20.00 m</name>
      <description>Avenida de servicio mixta: canal de rodamiento para gandolas continuas + batería de estacionamiento a 90° (~35 puestos) para locales comerciales del ala oeste.</description>
      <styleUrl>#lblAzul</styleUrl>
      <Point><coordinates>-64.63330,10.20473,0</coordinates></Point>
    </Placemark>

    <!-- Patio Sur 20 m -->
    <Placemark>
      <name>Patio Sur: 20.00 m</name>
      <description>Patio de maniobra y carga pesada frente a Repuestos de Oriente.</description>
      <styleUrl>#lblRoja</styleUrl>
      <Point><coordinates>-64.63290,10.20438,0</coordinates></Point>
    </Placemark>
