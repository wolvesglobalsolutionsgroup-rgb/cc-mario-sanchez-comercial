  <!-- 2. HUELLA CENTRAL (5.190 M²) SUBDIVIDIDA EN 3 MACRO-LOTES -->
  <Folder>
    <name>2. Subdivisión Huella Central (3 Macro-Lotes de 1.730 m²)</name>
    
    <!-- LOT-C01 -->
    <Placemark>
      <name>LOT-C01: Macro-Lote Norte (1.730 m²)</name>
      <description><![CDATA[
        <b>Superficie:</b> 1.730 m² (Nominal)<br>
        <b>Frente Vial:</b> 27,95 m al Pasillo Oeste de gandolas (20 m) + 64,31 m al Retiro Norte de Clientes.<br>
        <b>Usos Aprobados:</b> Concesionario, showroom de maquinaria, ferretería mayorista o retail.
      ]]></description>
      <styleUrl>#loteC01</styleUrl>
      <Polygon>
        <extrude>1</extrude>
        <altitudeMode>relativeToGround</altitudeMode>
        <outerBoundaryIs><LinearRing><coordinates>
          -64.6330805,10.2052798,4
          -64.6325082,10.2051530,4
          -64.6325616,10.2049191,4
          -64.6331306,10.2050319,4
          -64.6330805,10.2052798,4
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark><name>LOT-C01: 1.730 m² (Fte. 27,95 m)</name><styleUrl>#lblAmarilla</styleUrl><Point><coordinates>-64.63282,10.20509,4</coordinates></Point></Placemark>

    <!-- LOT-C02 -->
    <Placemark>
      <name>LOT-C02: Macro-Lote Central (1.730 m²)</name>
      <description><![CDATA[
        <b>Superficie:</b> 1.730 m² (Nominal)<br>
        <b>Frente Vial:</b> 27,95 m al Pasillo Oeste de gandolas (20 m) + Fondo Este al pasillo de retorno (23,80 m).<br>
        <b>Usos Aprobados:</b> Patio logístico de contenedores, galpón modular desmontable, almacén seco.
      ]]></description>
      <styleUrl>#loteC02</styleUrl>
      <Polygon>
        <extrude>1</extrude>
        <altitudeMode>relativeToGround</altitudeMode>
        <outerBoundaryIs><LinearRing><coordinates>
