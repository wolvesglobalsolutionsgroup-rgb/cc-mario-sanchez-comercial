          -64.6325616,10.2049191,4
          -64.6326151,10.2046851,4
          -64.6331808,10.2047841,4
          -64.6331306,10.2050319,4
        </coordinates></LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark><name>LOT-C02: 1.730 m² (Fte. 27,95 m)</name><styleUrl>#lblAmarilla</styleUrl><Point><coordinates>-64.63287,10.20485,4</coordinates></Point></Placemark>

    <!-- LOT-C03 -->
    <Placemark>
      <name>LOT-C03: Macro-Lote Sur (1.730 m²)</name>
      <description><![CDATA[
        <b>Superficie:</b> 1.730 m² (Nominal)<br>
        <b>Frente Vial:</b> 27,96 m al Pasillo Oeste (20 m) + Frente Sur directo al Patio de Maniobras de 20 m.<br>
        <b>Usos Aprobados:</b> Taller de servicio pesado, patio de gandolas y maquinaria, centro de distribución.
      ]]></description>
